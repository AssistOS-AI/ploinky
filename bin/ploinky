#!/usr/bin/env bash
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
    echo 'ploinky: Node.js 22 or newer is required on the host; node was not found on PATH.' >&2
    echo 'Install a supported Node.js LTS release from https://nodejs.org/en/download, reopen your shell, verify node --version, then rerun ploinky.' >&2
    exit 1
fi
NODE_VERSION=$(node --version 2>/dev/null) || NODE_VERSION='unavailable'
if [[ ! "$NODE_VERSION" =~ ^v([0-9]+)\. ]] || (( BASH_REMATCH[1] < 22 )); then
    echo "ploinky: Node.js 22 or newer is required on the host (observed: $NODE_VERSION)." >&2
    echo 'Upgrade Node.js using https://nodejs.org/en/download, verify node --version resolves to the new installation, then rerun ploinky.' >&2
    exit 1
fi

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
exec node "$SCRIPT_DIR/../ploinky-box/bin/ploinky-box.mjs" "$@"
