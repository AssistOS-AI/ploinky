#!/bin/bash

# This execution-plane entrypoint is exported for use inside the Linux Box.  On
# macOS the public `ploinky` entrypoint owns Box discovery and lifecycle; letting
# this helper run directly would bypass that boundary and could discover or
# mutate the host's remote container engine.
if ! PLOINKY_LOCAL_KERNEL=$(/usr/bin/uname -s 2>/dev/null); then
    echo "ploinky-local cannot establish its host boundary; run 'ploinky' through the managed Linux Box." >&2
    exit 78
fi
if [[ "$PLOINKY_LOCAL_KERNEL" != "Linux" ]]; then
    echo "ploinky-local refuses execution outside its managed Linux Box boundary; run 'ploinky' through the managed Box." >&2
    exit 78
fi

# Get the directory where the script is located
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
export PLOINKY_ROOT=$(realpath "$SCRIPT_DIR/..")

if [[ ! -d "$PLOINKY_ROOT/node_modules/achillesAgentLib" ]]; then
    echo "Ploinky dependency missing: $PLOINKY_ROOT/node_modules/achillesAgentLib" >&2
    echo "Run 'npm install' from $PLOINKY_ROOT before running ploinky." >&2
    exit 1
fi

# Route shell (formerly light) mode explicitly to the dedicated launcher
if [[ "$1" == "-shell" || "$1" == "sh" || "$1" == "--shell" ]]; then
    shift
    exec "$SCRIPT_DIR/ploinky-shell" "$@"
fi

# Construct the path to the Node.js script
NODE_SCRIPT="$SCRIPT_DIR/../cli/index.js"

# Execute the Node.js script with all passed arguments
node "$NODE_SCRIPT" "$@"
