{
  "image": "node:20-alpine",
  "readiness": {
    "protocol": "mcp"
  },
  "env": {
    "NODE_ENV": "production"
  },
  "enable": [
    {
      "agent": "dpu/dpu-agent",
      "alias": "dpu",
      "profile": "default"
    }
  ],
  "httpServices": [
    {
      "slug": "explorer-api",
      "externalPrefix": "/services/explorer-api/",
      "internalPrefix": "/api/",
      "auth": "authenticated"
    }
  ],
  "endpoints": {
    "agent-card": {
      "name": "Explorer",
      "description": "Searches and reads workspace documents.",
      "tags": ["documents", "search"]
    },
    "chatCompletions": {
      "command": "node",
      "args": ["tools/chat-completions.mjs"],
      "supportsStream": false
    }
  },
  "runtime": {
    "resources": {
      "memory": "512Mi",
      "cpu": "0.5"
    }
  }
}
