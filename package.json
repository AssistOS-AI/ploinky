{
    "name": "ploinky-cloud",
    "version": "1.0.0",
    "description": "Lightweight Node.js-based container orchestration platform",
    "type": "module",
    "main": "cloud/core/server.js",
    "bin": {
        "ploinky": "./bin/ploinky",
        "ploinky-local": "./bin/ploinky-local"
    },
    "scripts": {
        "start": "cd test_run_dir node bin/p-cloud",
        "clean": "rm -rf test_run_dir",
        "test": "./tests/run-all.sh",
        "e2e:routing-proxy": "node tests/e2e/routingProxy/run.mjs",
        "postinstall": "node ./ploinky-box/entrypoint/install-dependencies.mjs",
        "test:local-skills": "node tests/integration/local-skills/run.mjs",
        "test:authorization": "node tests/security/authorization/run.mjs",
        "test:authorization:harness": "node --test tests/security/authorization/*.test.mjs",
        "authorization:inventory": "node tests/security/authorization/coverage.mjs"
    },
    "keywords": [
        "ploinky",
        "cloud",
        "container",
        "orchestration",
        "microservices",
        "agent"
    ],
    "author": "Ploinky Team",
    "license": "MIT",
    "engines": {
        "node": ">=14.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/AssistOS-AI/ploinky.git"
    },
    "dependencies": {
        "mcp-sdk": "github:AssistOS-AI/MCPSDK#main"
    }
}
